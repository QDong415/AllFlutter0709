# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  verify_plugin = File.expand_path(
    '.symlinks/plugins/umeng_verify_sdk/ios/Classes/UmengVerifySdkPlugin.m',
    __dir__
  )
  if File.exist?(verify_plugin)
    source = File.read(verify_plugin)
    changed = false
    old_privacy_alert = <<~'OBJC'.rstrip
          // 未勾选协议时点击登录，使用 SDK 自带的二次确认弹窗。
          model.privacyAlertIsNeedShow = YES;
          model.privacyAlertIsNeedAutoLogin = YES;
          model.privacyAlertTitleContent = @"请先阅读并同意以下协议";
          model.privacyAlertBtnContent = @"同意并登录";
    OBJC
    if source.include?(old_privacy_alert)
      source.sub!(old_privacy_alert, '')
      changed = true
    end
    needle = 'return CGRectMake([arr[0] doubleValue], [arr[1] doubleValue], [arr[2] doubleValue], [arr[3] doubleValue]);'
    unless source.include?('width <= 0 拉满屏幕')
      source.sub!(needle, <<~'OBJC'.strip)
        CGFloat x = [arr[0] doubleValue];
                    CGFloat y = [arr[1] doubleValue];
                    CGFloat w = [arr[2] doubleValue];
                    CGFloat h = [arr[3] doubleValue];
                    if (y < 0) {
                        y = frame.origin.y;
                    }
                    if (w <= 0) {
                        x = 24;
                        w = screenSize.width - 48;
                    }
                    if (h <= 0) {
                        h = frame.size.height > 1 ? frame.size.height : 36;
                    }
                    return CGRectMake(x, y, w, h);
      OBJC
      changed = true
    end
    unless source.include?('未勾选协议时点击登录，让协议文字和勾选框左右轻微震动')
      source.sub!('#import "UmengVerifySdkPlugin.h"', <<~'OBJC'.rstrip)
        #import "UmengVerifySdkPlugin.h"
        #import <QuartzCore/QuartzCore.h>
      OBJC
      source.sub!('    return model;', <<~'OBJC'.rstrip)
            // 未勾选协议时点击登录，让协议文字和勾选框左右轻微震动。
            CAKeyframeAnimation *privacyShake =
                [CAKeyframeAnimation animationWithKeyPath:@"transform.translation.x"];
            privacyShake.values = @[@0, @-8, @8, @-6, @6, @-3, @3, @0];
            privacyShake.duration = 0.38;
            model.privacyAnimation = privacyShake;

            CAKeyframeAnimation *checkboxShake =
                [CAKeyframeAnimation animationWithKeyPath:@"transform.translation.x"];
            checkboxShake.values = privacyShake.values;
            checkboxShake.duration = privacyShake.duration;
            model.checkboxAnimation = checkboxShake;
            return model;
      OBJC
      changed = true
    end
    File.write(verify_plugin, source) if changed
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    next unless target.name == 'umeng_common_sdk'

    # 这个插件同时带了同名的 Swift 空实现和 Objective-C 实现。
    # 生成的 Swift 头会再声明一次 UmengCommonSdkPlugin，Xcode 报重复定义。
    # 真正的 initCommon 在 .m 里，去掉 Swift 文件即可。
    target.source_build_phase.files.to_a.each do |build_file|
      path = build_file.file_ref&.path.to_s
      next unless path.end_with?('UmengCommonSdkPlugin.swift')

      target.source_build_phase.remove_build_file(build_file)
    end
  end
end
